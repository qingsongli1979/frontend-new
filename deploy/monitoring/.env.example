# Rotate the credentials that appeared in chat before deploying this stack.
PROXY_USERNAME=replace-with-monitor-only-user
PROXY_PASSWORD=replace-with-rotated-password

# The original checker used myip.ipip.net. A 123Proxy-owned HTTP echo endpoint
# is preferable so a third-party outage cannot mark every proxy as unavailable.
PROBE_TARGET_URLS=http://myip.ipip.net
PROBE_PREFLIGHT=true

# Checks run in parallel. These defaults finish a cycle within one minute.
CHECK_INTERVAL_MS=60000
PROBE_TIMEOUT_MS=10000
PROBE_ATTEMPTS=3
PROBE_RETRY_DELAY_MS=1000
SERVICE_TIMEOUT_MS=8000
KUMA_PUSH_TIMEOUT_MS=5000

WEBSITE_CHECK_URL=https://www.123proxy.cn/healthz
CONSOLE_CHECK_URL=https://console.123proxy.cn/healthz
API_CHECK_URL=https://console.123proxy.cn/ip/mytraffic
API_HEALTH_TOKEN=replace-with-api-monitor-token

# Create nine Push monitors in Uptime Kuma and paste only their generated
# tokens here. Do not paste the entire Push URL.
KUMA_TOKEN_PROXY_TUNNEL=replace-me
KUMA_TOKEN_PROXY_RESIDENTIAL=replace-me
KUMA_TOKEN_PROXY_UNLIMITED=replace-me
KUMA_TOKEN_GATEWAY_US=replace-me
KUMA_TOKEN_GATEWAY_EU=replace-me
KUMA_TOKEN_GATEWAY_ASIA=replace-me
KUMA_TOKEN_WEBSITE=replace-me
KUMA_TOKEN_CONSOLE=replace-me
KUMA_TOKEN_API=replace-me

# Optional: enables POST /v1/run for an authenticated manual check.
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# The admin UI is bound to localhost by default.
KUMA_PORT=3001
