  "serviceChecks": [
    {
      "id": "website",
      "name": "123Proxy 官网",
      "urlEnv": "WEBSITE_CHECK_URL",
      "defaultUrl": "https://www.123proxy.cn/healthz",
      "expectText": "ok"
    },
    {
      "id": "console",
      "name": "123Proxy 控制台",
      "urlEnv": "CONSOLE_CHECK_URL",
      "defaultUrl": "https://console.123proxy.cn/healthz",
      "expectText": "ok"
    },
    {
      "id": "api",
      "name": "123Proxy API",
      "urlEnv": "API_CHECK_URL",
      "defaultUrl": "https://console.123proxy.cn/ip/mytraffic",
      "expectJson": true,
      "auth": {
        "type": "bearer",
        "tokenEnv": "API_HEALTH_TOKEN"
      }
    }
  ],
  "components": [
    {
      "id": "proxy-tunnel",
      "name": "隧道代理",
      "kind": "proxy-group",
      "selector": "product",
      "value": "proxy-tunnel",
      "pushTokenEnv": "KUMA_TOKEN_PROXY_TUNNEL"
    },
    {
      "id": "proxy-residential",
      "name": "隧道住宅代理",
      "kind": "proxy-group",
      "selector": "product",
      "value": "proxy-residential",
      "pushTokenEnv": "KUMA_TOKEN_PROXY_RESIDENTIAL"
    },
    {
      "id": "proxy-unlimited",
      "name": "不限量动态住宅",
      "kind": "proxy-group",
      "selector": "product",
      "value": "proxy-unlimited",
      "pushTokenEnv": "KUMA_TOKEN_PROXY_UNLIMITED"
    },
    {
      "id": "gateway-us",
      "name": "美国网关",
      "kind": "proxy-group",
      "selector": "region",
      "value": "gateway-us",
      "pushTokenEnv": "KUMA_TOKEN_GATEWAY_US"
    },
    {
      "id": "gateway-eu",
      "name": "欧洲网关",
      "kind": "proxy-group",
      "selector": "region",
      "value": "gateway-eu",
      "pushTokenEnv": "KUMA_TOKEN_GATEWAY_EU"
    },
    {
      "id": "gateway-asia",
      "name": "亚洲网关",
      "kind": "proxy-group",
      "selector": "region",
      "value": "gateway-asia",
      "pushTokenEnv": "KUMA_TOKEN_GATEWAY_ASIA"
    },
    {
      "id": "website",
      "name": "网站",
      "kind": "service",
      "serviceCheck": "website",
      "pushTokenEnv": "KUMA_TOKEN_WEBSITE"
    },
    {
      "id": "console",
      "name": "控制台",
      "kind": "service",
      "serviceCheck": "console",
      "pushTokenEnv": "KUMA_TOKEN_CONSOLE"
    },
    {
      "id": "api",
      "name": "API 服务",
      "kind": "service",
      "serviceCheck": "api",
      "pushTokenEnv": "KUMA_TOKEN_API"
    }
  ]
}
