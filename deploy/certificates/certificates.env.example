# Store the real file at /etc/123proxy/certificates.env with mode 600.
ACME_HOME=/var/lib/acme-123proxy
ACME_BIN=/var/lib/acme-123proxy/acme.sh
ACME_EMAIL=sales@123proxy.cn
ACME_SERVER=letsencrypt
DNS_SLEEP=120

# Use a dedicated Aliyun RAM user limited to DNS operations on 123proxy.cn.
Ali_Key=replace-with-aliyun-ram-access-key-id
Ali_Secret=replace-with-aliyun-ram-access-key-secret

CERT_MIN_VALID_DAYS=14
CERT_DIR=/data/cert
INSTALL_LOCAL=true

# Space-separated SSH targets for every other Swarm or Shenzhen frontend node.
# The SSH user must be able to run sudo install and docker kill.
CERT_REMOTE_TARGETS="root@swarm-node-2 root@shenzhen-frontend"
REMOTE_CERT_DIR=/data/cert
REMOTE_SUDO=sudo
SSH_IDENTITY_FILE=/etc/123proxy/cert-deploy-key
SSH_KNOWN_HOSTS_FILE=/etc/123proxy/ssh_known_hosts
