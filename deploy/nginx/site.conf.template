server {
    listen 80 default_server;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name 123proxy.cn;

    return 301 https://www.123proxy.cn$request_uri;
}

server {
    listen ${HTTPS_REDIRECT_LISTEN};
    server_name www.123proxy.cn console.123proxy.cn;

    return 301 https://$host$request_uri;
}

server {
    listen ${WEBSITE_LISTEN};
    server_name www.123proxy.cn;

    include /etc/nginx/tls/website.conf;

    root /var/www/website;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /status-api/ {
        proxy_pass ${STATUS_API_UPSTREAM}/;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        add_header Cache-Control "no-store" always;
    }

    location = /ip/default/offers {
        limit_except GET {
            deny all;
        }

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;

        set $ip_upstream ${IP_SERVICE_UPSTREAM};
        proxy_pass $ip_upstream;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        add_header Cache-Control "no-store" always;
    }

    location = /document/docs/intro/ {
        return 301 /developers/;
    }

    location = /document/docs/intro {
        return 301 /developers/;
    }

    location ^~ /blogs/ {
        set $wordpress_upstream ${WORDPRESS_UPSTREAM};
        proxy_pass $wordpress_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location ~* \.(?:css|js|mjs|svg|png|jpg|jpeg|webp|woff2)$ {
        try_files $uri =404;
        expires 7d;
    }

    location ~* \.html$ {
        try_files $uri =404;
        expires -1;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}

server {
    listen ${CONSOLE_LISTEN};
    server_name console.123proxy.cn;

    include /etc/nginx/tls/console.conf;

    root /var/www/console;
    index login.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = / {
        return 302 https://www.123proxy.cn/;
    }

    location = /index.html {
        return 302 https://www.123proxy.cn/;
    }

    location = /apiv1/yonghu/login {
        return 302 /login.html$is_args$args;
    }

    location = /apiv1/yonghu/register {
        return 302 /register.html$is_args$args;
    }

    location = /apiv1/yonghu/forgot-password {
        return 302 /forgot-password.html$is_args$args;
    }

    location = /apiv1/yonghu/aggrement {
        return 301 https://www.123proxy.cn/agreement.html;
    }

    location = /apiv1/console/orderDetail {
        return 302 "/app/#payment-return?provider=alipay&tradeNo=$arg_alipayreturn";
    }

    location = /console/orderDetail {
        return 302 "/app/#payment-return?provider=alipay&tradeNo=$arg_alipayreturn";
    }

    location = /apiv1/console/usercost {
        return 302 "/app/#recharge-return?provider=alipay&tradeNo=$arg_alipayreturn";
    }

    location = /console/usercost {
        return 302 "/app/#recharge-return?provider=alipay&tradeNo=$arg_alipayreturn";
    }

    location = /apiv1/managements/login-page {
        return 302 /agency-login.html$is_args$args;
    }

    location = /managements/login-page {
        return 302 /agency-login.html$is_args$args;
    }

    location ~ ^/(?:apiv1/)?agencyconsole/agency-manager/?$ {
        return 302 /agency-manager.html$is_args$args;
    }

    location ~ ^/(?:apiv1/)?agencyconsole/agency-manager-detail/[^/]+/?$ {
        try_files /agency-manager.html =404;
        expires -1;
    }

    location = /agreement.html {
        return 301 https://www.123proxy.cn/agreement.html;
    }

    location ~ ^/(?:login|register|forgot-password|aggrement|agency-login|agency-manager)\.html$ {
        try_files $uri =404;
        expires -1;
    }

    location = /app {
        return 302 /app/;
    }

    location = /app/ {
        try_files /app/index.html =404;
        expires -1;
    }

    location ^~ /app/ {
        try_files $uri =404;
        expires -1;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        expires 7d;
    }

    location ^~ /accsrv/sms-service/otp/ {
        limit_req zone=console_otp burst=2 nodelay;
        limit_req_status 429;
        include /etc/nginx/api-cors.conf;
        set $account_upstream ${ACCOUNT_SERVICE_UPSTREAM};
        proxy_pass $account_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location ^~ /accsrv/ {
        include /etc/nginx/api-cors.conf;
        set $account_upstream ${ACCOUNT_SERVICE_UPSTREAM};
        proxy_pass $account_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location ^~ /ssosrv/oauth/token {
        limit_req zone=console_login burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/api-cors.conf;
        set $auth_upstream ${AUTH_SERVICE_UPSTREAM};
        proxy_pass $auth_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location ^~ /ssosrv/ {
        include /etc/nginx/api-cors.conf;
        set $auth_upstream ${AUTH_SERVICE_UPSTREAM};
        proxy_pass $auth_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location ^~ /ip/ {
        include /etc/nginx/target/ip-rate-limit.conf;
        include /etc/nginx/api-cors.conf;
        set $ip_upstream ${IP_SERVICE_UPSTREAM};
        proxy_pass $ip_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location / {
        set $legacy_console_upstream ${LEGACY_CONSOLE_UPSTREAM};
        proxy_pass $legacy_console_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# ─── DATANITY API SERVER ──────────────────────────────
server {
    server_name api.flashdata.dev;

    # Uncomment and configure these if your Cloudflare SSL is set to "Full (Strict)"
    # and you have generated certificates for flashdata.dev on this server:
    listen 443 ssl http2;
    ssl_certificate /cert/flashdata.dev.pem;
    ssl_certificate_key /cert/flashdata.dev.key;
    ssl_session_timeout 5m;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!NULL:!aNULL:!MD5:!ADH:!RC4;
    ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
    ssl_prefer_server_ciphers on;

    resolver 127.0.0.11 valid=10s;

    location / {
        # Add CORS headers if Nginx needs to handle them (optional, your Node.js app might already do this)
        # add_header Access-Control-Allow-Origin *;
        # add_header Access-Control-Allow-Methods 'GET, POST, OPTIONS, PUT, DELETE';
        # add_header Access-Control-Allow-Headers 'DNT,X-Mx-ReqToken,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization';

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Forward traffic to the Docker Swarm service
        set $datanity_mgmt_backend "http://datanity-mgmt-backend:5000";
        proxy_pass $datanity_mgmt_backend;
    }
}

# ─── DATANITY DATA SERVER ──────────────────────────────
server {
    server_name data.flashdata.dev;

    # Uncomment and configure these if your Cloudflare SSL is set to "Full (Strict)"
    # and you have generated certificates for flashdata.dev on this server:
    listen 443 ssl http2;
    ssl_certificate /cert/flashdata.dev.pem;
    ssl_certificate_key /cert/flashdata.dev.key;
    ssl_session_timeout 5m;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE:ECDH:AES:HIGH:!NULL:!aNULL:!MD5:!ADH:!RC4;
    ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
    ssl_prefer_server_ciphers on;

    resolver 127.0.0.11 valid=10s;

    location / {
        # Add CORS headers if Nginx needs to handle them (optional, your Node.js app might already do this)
        # add_header Access-Control-Allow-Origin *;
        # add_header Access-Control-Allow-Methods 'GET, POST, OPTIONS, PUT, DELETE';
        # add_header Access-Control-Allow-Headers 'DNT,X-Mx-ReqToken,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization';

        #proxy_set_header Host $host;
        #proxy_set_header X-Real-IP $remote_addr;
        #proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        #proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $real_client_ip;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;


        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Buffer tuning for large JSON responses
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        # Forward traffic to the Docker Swarm service
        set $datanity_data_backend "http://datanity-data-backend:5000";
        proxy_pass $datanity_data_backend;
    }
}

